<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Vantage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vantage">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <!--
                Vantage brushes. StaticResource SolidColorBrush — flat
                (no ThemeDictionary wrapper at this scope; that pattern
                needs ResourceDictionary at App.Resources level which is
                coming in a follow-up). All brushes are picked to read
                well against the off-white page AND against dark system
                page backgrounds via subtle alpha overlays.
            -->
            <SolidColorBrush x:Key="PageBrush" Color="#F7FAFB" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFFFFFF" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F2F6F7" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#2607141A" />
            <SolidColorBrush x:Key="SoftStrokeBrush" Color="#1607141A" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#101A24" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6D7D86" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#94A0A6" />
            <!-- Used for inline error / validation messages (Add Provider
                 dialog, etc.). WinUI's ResourceDictionary INDEXER throws
                 when the key is missing, so we DO define this on purpose
                 rather than relying on a defensive fallback. -->
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />

            <!--
                Message bubble brushes — set as SolidColorBrush so they can
                be mutated in place by ThemeManager.Apply when the user
                switches palettes or switches dark mode. ChatMessage.cs
                reads them via BrushResolver.
            -->
            <SolidColorBrush x:Key="BubbleUserBrush" Color="#E8F1FB" />
            <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="BubbleErrorBrush" Color="#FBEEE8" />
            <SolidColorBrush x:Key="BubbleBorderUserBrush" Color="#260078D4" />
            <SolidColorBrush x:Key="BubbleBorderAssistantBrush" Color="#00000000" />
            <SolidColorBrush x:Key="BubbleBorderErrorBrush" Color="#E9B9A7" />
            <SolidColorBrush x:Key="AvatarUserBrush" Color="#E2E9EE" />
            <SolidColorBrush x:Key="AvatarAssistantBrush" Color="#D6E7F8" />
            <SolidColorBrush x:Key="AvatarErrorBrush" Color="#FBEEE8" />
            <SolidColorBrush x:Key="AuthorTextBrush" Color="#0078D4" />
            <!-- Keep the navigation quiet so conversations remain the focus. -->
            <SolidColorBrush x:Key="PaneBrush" Color="#F2F5F7" />
            <SolidColorBrush x:Key="RailBrush" Color="#E8EEF5" />
            <SolidColorBrush x:Key="ChatCanvasBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="PaneEdgeBrush" Color="#1607141A" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A86E0" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#0064B0" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FB" />
            <SolidColorBrush x:Key="WarmBrush" Color="#B66A42" />
            <SolidColorBrush x:Key="WarmHoverBrush" Color="#C77C58" />
            <SolidColorBrush x:Key="WarmPressedBrush" Color="#8E5030" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#237A4B" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#D8EFE2" />
            <SolidColorBrush x:Key="DangerBrush" Color="#A83232" />
            <SolidColorBrush x:Key="PanelTintBrush" Color="#E5F0FA" />
            <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerBorderBrush" Color="#D8DEE3" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="PendingBackgroundBrush" Color="#F7FAFB" />

            <CornerRadius x:Key="ComposerRadius">16</CornerRadius>
            <ThemeShadow x:Key="NewChatShadow" />
            <ThemeShadow x:Key="EmptyStateShadow" />
            <ThemeShadow x:Key="ComposerShadow" />

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="SuggestionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SuggestionRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <!-- AcceptsReturn=False so Enter doesn't insert a newline on
                     its own; our KeyDown handler always sends with Enter
                     and inserts a newline on Shift/Ctrl+Alt+Enter. -->
                <Setter Property="AcceptsReturn" Value="False" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Text" Value=" " />
            </Style>

            <!-- Settings cards use layered Fluent surfaces and a restrained stroke. -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <!--
                MessageBubble — chat message surface. Same shadow recipe
                but tighter radius (12) and slightly smaller padding so
                consecutive messages stack visually without feeling
                monolithic.
            -->
            <Style x:Key="MessageBubble" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,11" />
            </Style>

            <Style x:Key="ConversationListItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="ItemRoot" Background="Transparent" CornerRadius="10">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SubtleSurfaceBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected" />
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedUnfocused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                WinUI 3's default Button template swaps Background to a
                near-white theme brush on hover, which would hide our
                solid-fill buttons. Defining a custom ControlTemplate
                with VisualStateManager + Storyboard animations on the
                RootGrid's Background gives us full control over the
                visual states.
            -->
            <Style x:Key="GhostIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SubtleSurfaceBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ComposerModeToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="78" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ModeContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SubtleSurfaceBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ModeContent" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentFilledButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <!--
                    Default Padding = 14,8 keeps a balanced rhythm for
                    small icon-only buttons (40px circular). Buttons
                    that pass in their own Padding (e.g. the Add provider
                    CTA) override this and get shaped correctly because
                    the ContentPresenter's Margin is bound to Padding
                    below — fixing the old bug where the Style hardcoded
                    Padding=0 and silently overrode every instance.
                -->
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WarmFilledButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource WarmBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WarmHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WarmPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Extended Windows 11 titlebar: Mica remains visible while the
             brand and local-state signal become part of the window chrome. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="64" Background="{StaticResource ChatCanvasBrush}">
            <Border x:Name="TitlebarNavBackdrop" Width="292" HorizontalAlignment="Left"
                    Background="{StaticResource PaneBrush}" BorderBrush="{StaticResource PaneEdgeBrush}"
                    BorderThickness="0,0,1,0" />
            <TextBlock x:Name="BrandText" FontFamily="Segoe UI Variable Display, Segoe UI"
                       Margin="22,0,120,0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource PrimaryTextBrush}" Text="Vantage" />
            <Button x:Name="PaneToggleButton" Width="32" Height="32" Margin="244,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0"
                    Background="Transparent" BorderThickness="0" Click="PaneToggleButton_Click"
                    CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}"
                    ToolTipService.ToolTip="Collapse sidebar">
                <FontIcon x:Name="PaneToggleGlyph" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE76B;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ UNIFIED CONVERSATION SIDEBAR ============ -->
            <Border Grid.Column="0" Background="{StaticResource PaneBrush}"
                    BorderBrush="{StaticResource PaneEdgeBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid x:Name="ConversationPane" Padding="20,12,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button x:Name="NewChatButton" Grid.Row="0" Height="44" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource SoftStrokeBrush}"
                                BorderThickness="1" Click="NewChatButton_Click" CornerRadius="10"
                                Shadow="{StaticResource NewChatShadow}" Translation="0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
                                <FontIcon FontSize="17" Foreground="{StaticResource AccentBrush}" Glyph="&#xE710;" />
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="New chat" />
                            </StackPanel>
                        </Button>

                        <Grid Grid.Row="1" Margin="4,18,2,8">
                            <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" Text="Conversations" />
                            <Button HorizontalAlignment="Right" Width="30" Height="30" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="HeaderSearchButton_Click"
                                    CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}"
                                    ToolTipService.ToolTip="Search messages">
                                <FontIcon FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE721;" />
                            </Button>
                        </Grid>

                        <StackPanel x:Name="SearchPanel" Grid.Row="2" Spacing="8" Margin="0,0,0,8" Visibility="Collapsed">
                            <Border Height="36" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource SoftStrokeBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <TextBox x:Name="SearchBox" Padding="10,5" FontSize="13" Background="Transparent" BorderThickness="0"
                                         PlaceholderText="Search every message" TextChanged="SearchBox_TextChanged" />
                            </Border>
                            <Border x:Name="SearchResultsHost" MaxHeight="220" Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource SoftStrokeBrush}" BorderThickness="1" CornerRadius="10"
                                    Visibility="Collapsed">
                                <ListView x:Name="SearchResultsList" IsItemClickEnabled="True"
                                          ItemClick="SearchResultsList_ItemClick" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="58" Padding="10,7">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1" MaxLines="2" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}"
                                                           Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="3">
                        <ListView x:Name="ConversationList" IsItemClickEnabled="True"
                                      ItemClick="ConversationList_ItemClick" SelectionMode="Single"
                                      ItemContainerStyle="{StaticResource ConversationListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                        <Grid Height="60" Padding="10,6" ColumnSpacing="10">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Tag="{Binding}" Text="Rename" Click="RenameConversationMenuItem_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Tag="{Binding}" Text="Delete" Click="DeleteConversationMenuItem_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="8" Background="{Binding IconBackgroundBrush}">
                                                <FontIcon FontSize="16" Foreground="{Binding IconBrush}" Glyph="{Binding IconGlyph}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                                           Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding UpdatedLabel}" />
                                            </StackPanel>
                                        </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                            <TextBlock x:Name="SidebarEmptyState" Margin="10,14,0,0" HorizontalAlignment="Left"
                                       VerticalAlignment="Top" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                                       Text="No conversations yet" Visibility="Collapsed" />
                        </Grid>

                        <Border Grid.Row="4" Margin="0,10,0,0" Padding="0,8,0,0"
                                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <StackPanel Spacing="2">
                                <Button x:Name="ProvidersButton" Height="36" Padding="10,0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Click="ProvidersButton_Click"
                                        CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE967;" />
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="AI providers" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SettingsButton" Height="36" Padding="10,0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0" Click="SettingsButton_Click"
                                        CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE713;" />
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Settings" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="CollapsedSidebarCommands" Visibility="Collapsed" Margin="0,14,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <Button Width="40" Height="40" Padding="0" Background="{StaticResource AccentBrush}" BorderThickness="0"
                                    Click="NewChatButton_Click" CornerRadius="10" Style="{StaticResource AccentFilledButtonStyle}"
                                    ToolTipService.ToolTip="New chat">
                                <FontIcon FontSize="15" Foreground="White" Glyph="&#xE710;" />
                            </Button>
                            <Button Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0"
                                    Click="HeaderSearchButton_Click" CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}"
                                    ToolTipService.ToolTip="Search messages">
                                <FontIcon FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE721;" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="4" HorizontalAlignment="Center">
                            <Button x:Name="ProvidersButtonCollapsed" Width="40" Height="40" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="ProvidersButton_Click"
                                    CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}"
                                    ToolTipService.ToolTip="AI providers">
                                <FontIcon FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE967;" />
                            </Button>
                            <Button x:Name="SettingsButtonCollapsed" Width="40" Height="40" Padding="0"
                                    Background="Transparent" BorderThickness="0" Click="SettingsButton_Click"
                                    CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}"
                                    ToolTipService.ToolTip="Settings and appearance">
                                <FontIcon FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE713;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ CONTENT AREA ============ -->
            <Grid Grid.Column="1" Background="{StaticResource ChatCanvasBrush}">
                <!-- CHAT WORKSPACE -->
                <Grid
                    x:Name="Workspace"
                    Background="{StaticResource ChatCanvasBrush}"
                    Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Named state elements remain available to the controller without adding visible header chrome. -->
                    <Grid Visibility="Collapsed">
                        <TextBlock x:Name="ConversationTitleBlock" Text="New chat" />
                        <TextBlock x:Name="ConversationSubtitleBlock" Text="" />
                        <Border x:Name="RunStatusPill" Visibility="Collapsed">
                            <StackPanel>
                                <Ellipse x:Name="RunStatusPulse" />
                                <TextBlock x:Name="RunStatusText" Text="Running" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListView x:Name="MessagesList" Padding="36,28,36,18" SelectionMode="None" HorizontalContentAlignment="Stretch" Background="Transparent">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="18" />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,7" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="{Binding BubbleAlignment}" MaxWidth="800">
                                            <Grid ColumnSpacing="{Binding MessageColumnSpacing}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding AvatarColumnWidth}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--
                                                    Author avatar — a chunky
                                                    colored circle showing the
                                                    first letter. Adds presence
                                                    to each message and removes
                                                    the cramped 12px label.
                                                -->
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        Background="{Binding AvatarBrush}"
                                                        VerticalAlignment="Top" Visibility="{Binding AvatarVisibility}">
                                                    <Image Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Source="ms-appx:///Assets/Square44x44Logo.targetsize-44_altform-unplated.png" />
                                                </Border>
                                            <StackPanel Grid.Column="1">

                                                <!--
                                                    Plain text bubble — used for user messages,
                                                    EmitPlainReply, error cards, and any other
                                                    non-agent assistant message.
                                                -->
                                                <Border CornerRadius="8"
                                                        Padding="12,9,14,10"
                                                        Background="{Binding BubbleBrush}"
                                                        BorderBrush="{Binding BubbleBorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding ContentVisibility}">
                                                        <StackPanel Spacing="6">
                                                        <Grid ColumnSpacing="14" Visibility="{Binding MetadataVisibility}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding AuthorBrush}"
                                                                       Text="{Binding AuthorDisplay}" />
                                                            <TextBlock Grid.Column="1" FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding TimeLabel}" />
                                                        </Grid>
                                                        <Border MaxHeight="320"
                                                                 Background="{StaticResource SubtleSurfaceBrush}"
                                                                 CornerRadius="8"
                                                                Visibility="{Binding ImageVisibility}">
                                                            <Image MaxHeight="300" Source="{Binding ImageSource}" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock FontSize="14.5"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   LineHeight="23"
                                                                   Text="{Binding CleanText}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding TextVisibility}" />
                                                    </StackPanel>
                                                </Border>

                                                <!--
                                                    Agent-run visualization. Replaces the old raw
                                                    step log with a structured stepper, progress
                                                    bar, live counter strip, and an animated dot.
                                                -->
                                                <Border CornerRadius="8"
                                                        Padding="0"
                                                        Background="{Binding BubbleBrush}"
                                                        BorderBrush="{Binding BubbleBorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding AgentRunVisibility}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <!-- HEADER: title + status + elapsed pill -->
                                                        <Border Grid.Row="0"
                                                                Padding="15,11,15,11"
                                                                BorderBrush="{StaticResource SoftStrokeBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid ColumnSpacing="11">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="8" Height="8"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{StaticResource AccentBrush}" />
                                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                               Text="{Binding AgentRun.HeaderTitle}" />
                                                                    <TextBlock FontSize="11.5"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Text="{Binding AgentRun.StatusText}" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Padding="10,5"
                                                                        CornerRadius="999"
                                                                        Background="{StaticResource SubtleSurfaceBrush}"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Text="{Binding AgentRun.ElapsedLabel}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" Padding="18,14,18,16" Spacing="12">

                                                            <ProgressBar Height="6" CornerRadius="3"
                                                                         Minimum="0" Maximum="100"
                                                                         IsIndeterminate="{Binding AgentRun.ProgressIndeterminate}"
                                                                         Value="{Binding AgentRun.ProgressPercent}"
                                                                         Foreground="{StaticResource AccentBrush}"
                                                                         Background="{StaticResource SubtleSurfaceBrush}" />

                                                            <Border Padding="10,7"
                                                                    CornerRadius="8"
                                                                    Background="{StaticResource SubtleSurfaceBrush}">
                                                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Glyph="&#xE8D7;"
                                                                              FontSize="12"
                                                                              Foreground="{StaticResource SecondaryTextBrush}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               FontSize="11.5"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               TextWrapping="WrapWholeWords"
                                                                               Text="{Binding AgentRun.EvidenceSummary}" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Vertical stepper — every phase lights up as it completes. -->
                                                            <ItemsControl ItemsSource="{Binding AgentRun.Phases}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2" ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="28" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid Width="28">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="22" />
                                                                                    <RowDefinition Height="*" />
                                                                                </Grid.RowDefinitions>
                                                                                <Grid Width="22" Height="22" VerticalAlignment="Top">
                                                                                    <Ellipse Width="22" Height="22"
                                                                                             StrokeThickness="2"
                                                                                             Stroke="{StaticResource AccentBrush}"
                                                                                             Fill="Transparent" />
                                                                                    <FontIcon Glyph="{Binding IconGlyph}"
                                                                                              FontSize="11"
                                                                                              Foreground="{StaticResource AccentBrush}"
                                                                                              HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center" />
                                                                                </Grid>
                                                                                <Rectangle Grid.Row="1"
                                                                                           Width="2"
                                                                                           HorizontalAlignment="Center"
                                                                                           Fill="{StaticResource SoftStrokeBrush}" />
                                                                            </Grid>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,1,0,0">
                                                                                <TextBlock FontSize="13"
                                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                                           Text="{Binding Title}" />
                                                                                <TextBlock FontSize="11.5"
                                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                                           Text="{Binding Subtitle}"
                                                                                           Visibility="{Binding HasSubtitle}"
                                                                                           Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="2" FontSize="11.5"
                                                                                       VerticalAlignment="Top" Margin="0,1,0,0"
                                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                                       Text="{Binding DurationLabel}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Counter strip — appears once the agent has done something. -->
                                                            <ItemsControl ItemsSource="{Binding AgentRun.Counters}"
                                                                          Visibility="{Binding AgentRun.CountersVisibility}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Padding="9,4" Margin="0,0,6,6"
                                                                                CornerRadius="999"
                                                                                Background="{StaticResource SubtleSurfaceBrush}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                <FontIcon Glyph="{Binding Glyph}" FontSize="11"
                                                                                          Foreground="{StaticResource SecondaryTextBrush}" />
                                                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                                           Text="{Binding Label}" />
                                                                                <Border Padding="6,1" CornerRadius="6"
                                                                                        Background="{StaticResource SurfaceElevatedBrush}">
                                                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                                                                               Foreground="{StaticResource AccentBrush}"
                                                                                               Text="{Binding Count}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Termination card — shown only when the run finishes. -->
                                                            <Border Padding="12,10" CornerRadius="10"
                                                                    Visibility="{Binding AgentRun.IsFinishedVisibility}"
                                                                    Background="{StaticResource SubtleSurfaceBrush}"
                                                                    BorderBrush="{StaticResource SoftStrokeBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           Text="{Binding AgentRun.TerminationLabel}" />
                                                            </Border>

                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!--
                                                    Copy button — modern chat UI affordance. Sits
                                                    just below the bubble(s), right-aligned, and
                                                    copies the message text to the clipboard when
                                                    clicked. The click handler (MainWindow.Chat.cs)
                                                    swaps the FontIcon for a checkmark for ~1.5 s
                                                    as feedback, then restores the original copy
                                                    glyph. Hidden for empty messages via
                                                    CopyButtonVisibility on ChatMessage.
                                                -->
                                                <Button HorizontalAlignment="Right"
                                                        Margin="0,4,2,0"
                                                        Padding="0"
                                                        Width="28" Height="28"
                                                        CornerRadius="8"
                                                        Click="CopyMessageButton_Click"
                                                        Tag="{Binding}"
                                                        ToolTipService.ToolTip="Copy message"
                                                        Style="{StaticResource GhostIconButtonStyle}"
                                                        Visibility="{Binding CopyButtonVisibility}">
                                                    <FontIcon FontSize="13"
                                                              Foreground="{StaticResource SecondaryTextBrush}"
                                                              Glyph="&#xE8C8;" />
                                                </Button>

                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="EmptyState" MaxWidth="640" Margin="32,0,32,90"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="22">
                            <Border Width="72" Height="72" CornerRadius="14" HorizontalAlignment="Center"
                                    Background="{StaticResource SurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource SoftStrokeBrush}" BorderThickness="1"
                                    Shadow="{StaticResource EmptyStateShadow}" Translation="0,0,12">
                                <Image Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
                            </Border>
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="What can I help with?" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Modern Composer — fills the window width with a
                         comfortable outer padding so it never feels like
                         a tiny card floating on white space. -->
                    <Border
                        x:Name="ComposerHost"
                        Grid.Row="2"
                        Padding="32,0,32,36"
                        HorizontalAlignment="Stretch"
                        MaxWidth="980">
                        <Border
                            x:Name="ComposerCard"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource ComposerBrush}"
                            BorderBrush="{StaticResource ComposerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ComposerRadius}"
                            Shadow="{StaticResource ComposerShadow}"
                            Translation="0,0,18">
                            <Grid Height="64" Padding="18,8,10,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="InputBox"
                                        Grid.Column="0"
                                        MinHeight="40"
                                        MaxHeight="48"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        PlaceholderText="Message Vantage"
                                        KeyDown="InputBox_KeyDown"
                                        Style="{StaticResource ComposerTextBoxStyle}" />
                                     <ComboBox x:Name="ModelSelector"
                                               Grid.Column="1"
                                               Width="196" Height="40"
                                               Padding="10,0"
                                               CornerRadius="12"
                                               Background="{StaticResource SubtleSurfaceBrush}"
                                               BorderBrush="{StaticResource SoftStrokeBrush}"
                                               SelectionChanged="ModelSelector_SelectionChanged"
                                               ToolTipService.ToolTip="Active model">
                                         <ComboBox.ItemTemplate>
                                             <DataTemplate>
                                                 <StackPanel Spacing="0" ToolTipService.ToolTip="{Binding Tooltip}">
                                                     <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                                Text="{Binding Display}" />
                                                     <TextBlock FontSize="10.5"
                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                Text="{Binding ProviderDisplay}" />
                                                 </StackPanel>
                                             </DataTemplate>
                                         </ComboBox.ItemTemplate>
                                     </ComboBox>
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="SendButton" Width="40" Height="40" Padding="0" Background="{StaticResource AccentBrush}" BorderThickness="0" Click="SendButton_Click" CornerRadius="20" Style="{StaticResource AccentFilledButtonStyle}" ToolTipService.ToolTip="Send message">
                                            <FontIcon FontSize="16" Foreground="White" Glyph="&#xE724;" />
                                        </Button>
                                        <Button x:Name="StopButton" Width="40" Height="40" Padding="0" Background="{StaticResource WarmBrush}" BorderThickness="0" Click="StopButton_Click" CornerRadius="20" Visibility="Collapsed" Style="{StaticResource WarmFilledButtonStyle}" ToolTipService.ToolTip="Stop response">
                                            <FontIcon FontSize="14" Foreground="White" Glyph="&#xE15B;" />
                                        </Button>
                                    </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- SETTINGS PAGE -->
                <ScrollViewer
                    x:Name="SettingsGrid"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed"
                    Background="{StaticResource PageBrush}">
                    <Grid Padding="36,28,36,40">
                        <Grid HorizontalAlignment="Stretch" MaxWidth="860">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                        <FontIcon FontSize="17" Foreground="{StaticResource AccentBrush}" Glyph="&#xE713;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Text="Appearance, local data, and app details" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Appearance" />
                                            <TextBlock FontSize="12.5" LineHeight="18" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Pick an accent color, then choose light or dark to match your workspace. The change is instant." />
                                        </StackPanel>

                                        <!--
                                            Palette picker — horizontal strip
                                            of radio cards, a swatch + label
                                            each. Built directly in code-behind
                                            (WinUI 3 doesn't ship WrapPanel
                                            the way WPF does — using a custom
                                            stack here keeps the markup simple
                                            and the cards identical).
                                        -->
                                        <ScrollViewer HorizontalScrollMode="Enabled"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollMode="Disabled"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="PalettePicker"
                                                        Loaded="PalettePicker_Loaded"
                                                        Orientation="Horizontal" Spacing="8" />
                                        </ScrollViewer>

                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Theme mode" />
                                            <ComboBox
                                                x:Name="ThemeModeCombo"
                                                Width="240"
                                                HorizontalAlignment="Left"
                                                SelectionChanged="ThemeModeCombo_SelectionChanged">
                                                <ComboBoxItem Content="Light"   Tag="Light" />
                                                <ComboBoxItem Content="Dark"    Tag="Dark" />
                                                <ComboBoxItem Content="System (follow Windows)" Tag="System" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                        <StackPanel Spacing="11">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="15" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE74D;" />
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Local data" />
                                            </StackPanel>
                                            <TextBlock FontSize="12.5" LineHeight="18" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Chat history stays on this PC until you clear it." />
                                            <Button HorizontalAlignment="Left" Background="Transparent" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Click="ClearHistoryButton_Click" CornerRadius="8" Foreground="{StaticResource DangerBrush}" Padding="10,6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    <TextBlock Text="Clear history" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource SectionCard}">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Width="19" Height="19" Source="ms-appx:///Assets/Square44x44Logo.targetsize-44_altform-unplated.png" />
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="About Vantage" />
                                            </StackPanel>
                                            <TextBlock x:Name="AboutVersionText" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Text="Vantage &#x2014; Local-first AI control panel for Windows." TextWrapping="Wrap" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Windows App SDK 1.8 &#x2022; WinUI 3" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- PROVIDERS PAGE -->
                <ScrollViewer
                    x:Name="ProvidersGrid"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed"
                    Background="{StaticResource PageBrush}">
                    <Grid Padding="36,28,36,40">
                        <Grid HorizontalAlignment="Stretch" MaxWidth="860">
                            <StackPanel Spacing="16">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                            <FontIcon FontSize="17" Foreground="{StaticResource AccentBrush}" Glyph="&#xE967;" />
                                        </Border>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="AI Providers" />
                                            <TextBlock FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Text="Models and endpoints available to Vantage" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Margin="18,2,0,0"
                                        Background="{StaticResource AccentBrush}"
                                        BorderThickness="0"
                                        Click="AddProviderButton_Click"
                                        CornerRadius="8"
                                        MinHeight="38"
                                        Padding="16,0,16,0"
                                        Style="{StaticResource AccentFilledButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontSize="14" Foreground="White" Glyph="&#xE710;" />
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="White" Text="Add provider" TextLineBounds="Tight" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel x:Name="ProvidersList" Spacing="10" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Agent overlay removed — the user wanted zero UI intrusions. The
             agent now runs invisibly; Escape + composer Stop button + the
             20-step cap are the only remaining safety surfaces. -->
    </Grid>
</Window>
