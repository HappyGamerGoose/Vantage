<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Vantage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="">
    <Grid
        x:Name="RootGrid"
        Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <!--
                Vantage brushes. StaticResource SolidColorBrush — flat
                (no ThemeDictionary wrapper at this scope; that pattern
                needs ResourceDictionary at App.Resources level which is
                coming in a follow-up). All brushes are picked to read
                well against the off-white page AND against dark system
                page backgrounds via subtle alpha overlays.
            -->
            <SolidColorBrush x:Key="PageBrush" Color="#F7FAFB" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFFFFFF" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F2F6F7" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#2607141A" />
            <SolidColorBrush x:Key="SoftStrokeBrush" Color="#1607141A" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#101A24" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6D7D86" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#94A0A6" />
            <!-- Used for inline error / validation messages (Add Provider
                 dialog, etc.). WinUI's ResourceDictionary INDEXER throws
                 when the key is missing, so we DO define this on purpose
                 rather than relying on a defensive fallback. -->
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />

            <!--
                Message bubble brushes — set as SolidColorBrush so they can
                be mutated in place by ThemeManager.Apply when the user
                switches palettes or switches dark mode. ChatMessage.cs
                reads them via BrushResolver.
            -->
            <SolidColorBrush x:Key="BubbleUserBrush" Color="#FCFCFC" />
            <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#F2F6F7" />
            <SolidColorBrush x:Key="BubbleErrorBrush" Color="#FBEEE8" />
            <SolidColorBrush x:Key="BubbleBorderUserBrush" Color="#1407141A" />
            <SolidColorBrush x:Key="BubbleBorderAssistantBrush" Color="#2607141A" />
            <SolidColorBrush x:Key="BubbleBorderErrorBrush" Color="#E9B9A7" />
            <SolidColorBrush x:Key="AvatarUserBrush" Color="#E2E9EE" />
            <SolidColorBrush x:Key="AvatarAssistantBrush" Color="#D6E7F8" />
            <SolidColorBrush x:Key="AvatarErrorBrush" Color="#FBEEE8" />
            <SolidColorBrush x:Key="AuthorTextBrush" Color="#00D78CD4" />
            <!--
                Sidebar tint — a subtle two-stop vertical gradient that
                gives the sidebar a distinct "panel" feeling against the
                main workspace without resorting to a contrasting color.
                Top: matches the page; bottom: tinted cooler so the eye
                reads "this side is chrome, the rest is content".
            -->
            <LinearGradientBrush x:Key="PaneBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F2F5F7" Offset="0.0" />
                <GradientStop Color="#E4EAEE" Offset="1.0" />
            </LinearGradientBrush>
            <!--
                Accent-tinted right edge — thin, visible, never heavy.
                Replaces the old neutral hairline so the column boundary
                reads as "deliberate" rather than "incidental".
            -->
            <SolidColorBrush x:Key="PaneEdgeBrush" Color="#260078D4" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A86E0" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#0064B0" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FB" />
            <SolidColorBrush x:Key="WarmBrush" Color="#B66A42" />
            <SolidColorBrush x:Key="WarmHoverBrush" Color="#C77C58" />
            <SolidColorBrush x:Key="WarmPressedBrush" Color="#8E5030" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#237A4B" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#D8EFE2" />
            <SolidColorBrush x:Key="DangerBrush" Color="#A83232" />
            <SolidColorBrush x:Key="PanelTintBrush" Color="#E5F0FA" />
            <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerBorderBrush" Color="#D8DEE3" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="PendingBackgroundBrush" Color="#F7FAFB" />

            <CornerRadius x:Key="ComposerRadius">16</CornerRadius>

            <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <!-- AcceptsReturn=False so Enter doesn't insert a newline on
                     its own; our KeyDown handler always sends with Enter
                     and inserts a newline on Shift/Ctrl+Alt+Enter. -->
                <Setter Property="AcceptsReturn" Value="False" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Text" Value=" " />
            </Style>

            <!--
                SectionCard — settings cards in SettingsGrid / ProvidersGrid.
                Drops the hairline border in favor of elevation: a soft
                surface sits on a softer ambient and gets a 32px theme
                shadow so the card reads as physically lifted off the
                page. Padding bumped to 28 for breathing room.
            -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="28" />
            </Style>

            <!--
                MessageBubble — chat message surface. Same shadow recipe
                but tighter radius (12) and slightly smaller padding so
                consecutive messages stack visually without feeling
                monolithic.
            -->
            <Style x:Key="MessageBubble" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <!--
                WinUI 3's default Button template swaps Background to a
                near-white theme brush on hover, which would hide our
                solid-fill buttons. Defining a custom ControlTemplate
                with VisualStateManager + Storyboard animations on the
                RootGrid's Background gives us full control over the
                visual states.
            -->
            <Style x:Key="GhostIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SubtleSurfaceBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentFilledButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <!--
                    Default Padding = 14,8 keeps a balanced rhythm for
                    small icon-only buttons (40px circular). Buttons
                    that pass in their own Padding (e.g. the Add provider
                    CTA) override this and get shaped correctly because
                    the ContentPresenter's Margin is bound to Padding
                    below — fixing the old bug where the Style hardcoded
                    Padding=0 and silently overrode every instance.
                -->
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WarmFilledButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource WarmBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WarmHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WarmPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="288" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border
                Grid.Column="0"
                Background="{StaticResource PaneBrush}"
                BorderBrush="{StaticResource PaneEdgeBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- TOP: actions (no brand text) -->
                    <Grid Grid.Row="0" Padding="16,16,16,8">
                        <Grid x:Name="ExpandedTopRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PaneToggleButton" Grid.Column="0" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Click="PaneToggleButton_Click" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}">
                                <FontIcon FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Glyph="&#xE700;" />
                            </Button>
                            <Button x:Name="NewChatButton" Grid.Column="2" Width="40" Height="40" Padding="0" Background="{StaticResource AccentBrush}" BorderThickness="0" Click="NewChatButton_Click" CornerRadius="10" Style="{StaticResource AccentFilledButtonStyle}">
                                <FontIcon FontSize="15" Foreground="White" Glyph="&#xE710;" />
                            </Button>
                        </Grid>
                        <StackPanel
                            x:Name="CollapsedTopStack"
                            Spacing="10"
                            Visibility="Collapsed">
                            <Button x:Name="PaneToggleButtonCollapsed" Width="40" Height="40" HorizontalAlignment="Center" Padding="0" Background="Transparent" BorderThickness="0" Click="PaneToggleButton_Click" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}">
                                <FontIcon FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Glyph="&#xE700;" />
                            </Button>
                            <Button x:Name="NewChatButtonCollapsed" Width="40" Height="40" HorizontalAlignment="Center" Padding="0" Background="{StaticResource AccentBrush}" BorderThickness="0" Click="NewChatButton_Click" CornerRadius="10" Style="{StaticResource AccentFilledButtonStyle}">
                                <FontIcon FontSize="15" Foreground="White" Glyph="&#xE710;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- MIDDLE: search + conv list (expanded) -->
                    <Grid
                        x:Name="MiddleSection"
                        Grid.Row="1"
                        Padding="18,4,18,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Row="0"
                            Height="40"
                            Padding="12,7"
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            PlaceholderText="Search messages"
                            TextChanged="SearchBox_TextChanged" />
                        <Border
                            x:Name="SearchResultsHost"
                            Grid.Row="1"
                            MaxHeight="210"
                            Margin="0,10,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource SoftStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <ListView
                                x:Name="SearchResultsList"
                                IsItemClickEnabled="True"
                                ItemClick="SearchResultsList_ItemClick"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="58" Padding="10,7">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" MaxLines="2" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <TextBlock Grid.Row="2" Margin="2,16,2,8" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Text="RECENT" />
                        <ListView
                            x:Name="ConversationList"
                            Grid.Row="3"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            IsItemClickEnabled="True"
                            ItemClick="ConversationList_ItemClick"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="62" Padding="10,7" ColumnSpacing="10">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Tag="{Binding}" Text="Rename" Click="RenameConversationMenuItem_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Tag="{Binding}" Text="Delete" Click="DeleteConversationMenuItem_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock MaxLines="1" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding LastMessagePreview}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding UpdatedLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!--
                            Sidebar footer caption — quiet one-line note
                            that fills dead space below the conversation
                            list without competing with anything. Sits at
                            the bottom of the middle row so the list area
                            reads as "intentional negative space" rather
                            than dead air when only a few conversations exist.
                        -->
                    </Grid>

                    <!-- BOTTOM: nav buttons (expanded and collapsed).
                         A subtle hairline at the top of this row separates
                         the chrome zone from the list zone, so the bottom
                         reads as a deliberate footer rather than dangling
                         buttons below a sea of empty space. -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource SoftStrokeBrush}" BorderThickness="0,1,0,0" Padding="18,10,18,16">
                        <Grid>
                            <StackPanel x:Name="ExpandedBottomStack" Spacing="4" Visibility="Visible">
                                <Button x:Name="ProvidersButton" MinHeight="42" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="ProvidersButton_Click" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <FontIcon FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE967;" />
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="AI Providers" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SettingsButton" MinHeight="42" Padding="12,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="SettingsButton_Click" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <FontIcon FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE713;" />
                                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Settings" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="CollapsedBottomStack" Spacing="10" Visibility="Collapsed" HorizontalAlignment="Center">
                                <Button x:Name="ProvidersButtonCollapsed" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Click="ProvidersButton_Click" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}">
                                    <FontIcon FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE967;" />
                                </Button>
                                <Button x:Name="SettingsButtonCollapsed" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" Click="SettingsButton_Click" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}">
                                    <FontIcon FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE713;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ CONTENT AREA ============ -->
            <Grid Grid.Column="1" Background="{StaticResource PageBrush}">
                <!-- CHAT WORKSPACE -->
                <Grid
                    x:Name="Workspace"
                    Background="{StaticResource PageBrush}"
                    Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="28,18,28,16" Background="{StaticResource PageBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <!--
                            Chat workspace header (conversation title + status pill).
                            Hidden by default — the user-facing name and run status
                            are conveyed through the sidebar / status pill elsewhere.
                            The named elements inside are still set by code so the
                            bindings remain valid in case we re-show this row.
                        -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ConversationTitleBlock" MaxWidth="640" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Vantage" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ConversationSubtitleBlock" MaxWidth="640" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Direct Windows desktop agent" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!--
                                Live status pill — quiet by default, animated
                                when the agent is responding. Hides the input
                                pulse; users get an ambient signal that the
                                loop is on, not a banner.
                            -->
                            <Border x:Name="RunStatusPill"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="10,5"
                                    Background="{StaticResource SubtleSurfaceBrush}"
                                    CornerRadius="999"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Grid Width="10" Height="10">
                                        <Ellipse Fill="{StaticResource AccentBrush}" Width="10" Height="10" />
                                        <Ellipse x:Name="RunStatusPulse" Fill="{StaticResource AccentBrush}" Width="10" Height="10" Opacity="0.5" />
                                    </Grid>
                                    <TextBlock x:Name="RunStatusText" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Running" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListView x:Name="MessagesList" Padding="40,28,40,16" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="{Binding BubbleAlignment}" MaxWidth="840">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!--
                                                    Author avatar — a chunky
                                                    colored circle showing the
                                                    first letter. Adds presence
                                                    to each message and removes
                                                    the cramped 12px label.
                                                -->
                                                <Border Width="38" Height="38" CornerRadius="19"
                                                        Background="{Binding AvatarBrush}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{Binding AuthorBrush}"
                                                               Text="{Binding AuthorInitial}" />
                                                </Border>
                                            <StackPanel Grid.Column="1">

                                                <!--
                                                    Plain text bubble — used for user messages,
                                                    EmitPlainReply, error cards, and any other
                                                    non-agent assistant message.
                                                -->
                                                <Border CornerRadius="16"
                                                        Padding="14,10,16,12"
                                                        Background="{Binding BubbleBrush}"
                                                        BorderBrush="{Binding BubbleBorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding TextVisibility}">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnSpacing="14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{Binding AuthorBrush}"
                                                                       Text="{Binding AuthorDisplay}" />
                                                            <TextBlock Grid.Column="1" FontSize="11"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       Text="{Binding TimeLabel}" />
                                                        </Grid>
                                                        <Border MaxHeight="340"
                                                                Background="{StaticResource SubtleSurfaceBrush}"
                                                                CornerRadius="10"
                                                                Visibility="{Binding ImageVisibility}">
                                                            <Image MaxHeight="340" Source="{Binding ImageSource}" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock FontSize="15"
                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                   LineHeight="24"
                                                                   Text="{Binding CleanText}"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding TextVisibility}" />
                                                    </StackPanel>
                                                </Border>

                                                <!--
                                                    Agent-run visualization. Replaces the old raw
                                                    step log with a structured stepper, progress
                                                    bar, live counter strip, and an animated dot.
                                                -->
                                                <Border CornerRadius="16"
                                                        Padding="0"
                                                        Background="{Binding BubbleBrush}"
                                                        BorderBrush="{Binding BubbleBorderBrush}"
                                                        BorderThickness="1"
                                                        Visibility="{Binding AgentRunVisibility}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <!-- HEADER: title + status + elapsed pill -->
                                                        <Border Grid.Row="0"
                                                                Padding="18,14,18,14"
                                                                BorderBrush="{StaticResource SoftStrokeBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid ColumnSpacing="14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Width="10" Height="10"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{StaticResource AccentBrush}" />
                                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                                               Text="{Binding AgentRun.HeaderTitle}" />
                                                                    <TextBlock FontSize="11.5"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Text="{Binding AgentRun.StatusText}" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Padding="10,5"
                                                                        CornerRadius="999"
                                                                        Background="{StaticResource SubtleSurfaceBrush}"
                                                                        VerticalAlignment="Center">
                                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                                               Text="{Binding AgentRun.ElapsedLabel}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Row="1" Padding="18,14,18,16" Spacing="12">

                                                            <ProgressBar Height="6" CornerRadius="3"
                                                                         Minimum="0" Maximum="100"
                                                                         IsIndeterminate="{Binding AgentRun.ProgressIndeterminate}"
                                                                         Value="{Binding AgentRun.ProgressPercent}"
                                                                         Foreground="{StaticResource AccentBrush}"
                                                                         Background="{StaticResource SubtleSurfaceBrush}" />

                                                            <!-- Vertical stepper — every phase lights up as it completes. -->
                                                            <ItemsControl ItemsSource="{Binding AgentRun.Phases}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,2" ColumnSpacing="12">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="28" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid Width="28">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="22" />
                                                                                    <RowDefinition Height="*" />
                                                                                </Grid.RowDefinitions>
                                                                                <Grid Width="22" Height="22" VerticalAlignment="Top">
                                                                                    <Ellipse Width="22" Height="22"
                                                                                             StrokeThickness="2"
                                                                                             Stroke="{StaticResource AccentBrush}"
                                                                                             Fill="Transparent" />
                                                                                    <FontIcon Glyph="{Binding IconGlyph}"
                                                                                              FontSize="11"
                                                                                              Foreground="{StaticResource AccentBrush}"
                                                                                              HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center" />
                                                                                </Grid>
                                                                                <Rectangle Grid.Row="1"
                                                                                           Width="2"
                                                                                           HorizontalAlignment="Center"
                                                                                           Fill="{StaticResource SoftStrokeBrush}" />
                                                                            </Grid>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,1,0,0">
                                                                                <TextBlock FontSize="13"
                                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                                           Text="{Binding Title}" />
                                                                                <TextBlock FontSize="11.5"
                                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                                           Text="{Binding Subtitle}"
                                                                                           Visibility="{Binding HasSubtitle}"
                                                                                           Margin="0,2,0,0" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="2" FontSize="11.5"
                                                                                       VerticalAlignment="Top" Margin="0,1,0,0"
                                                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                                                       Text="{Binding DurationLabel}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Counter strip — appears once the agent has done something. -->
                                                            <ItemsControl ItemsSource="{Binding AgentRun.Counters}"
                                                                          Visibility="{Binding AgentRun.CountersVisibility}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Padding="9,4" Margin="0,0,6,6"
                                                                                CornerRadius="999"
                                                                                Background="{StaticResource SubtleSurfaceBrush}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                <FontIcon Glyph="{Binding Glyph}" FontSize="11"
                                                                                          Foreground="{StaticResource SecondaryTextBrush}" />
                                                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                                           Text="{Binding Label}" />
                                                                                <Border Padding="6,1" CornerRadius="6"
                                                                                        Background="{StaticResource SurfaceElevatedBrush}">
                                                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold"
                                                                                               Foreground="{StaticResource AccentBrush}"
                                                                                               Text="{Binding Count}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Termination card — shown only when the run finishes. -->
                                                            <Border Padding="12,10" CornerRadius="10"
                                                                    Visibility="{Binding AgentRun.IsFinishedVisibility}"
                                                                    Background="{StaticResource SubtleSurfaceBrush}"
                                                                    BorderBrush="{StaticResource SoftStrokeBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock FontSize="13" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                                           Text="{Binding AgentRun.TerminationLabel}" />
                                                            </Border>

                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            x:Name="EmptyState"
                            Width="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">
                            <!--
                                Empty state — flat typographic layout.
                                No chunky card, no 3D icon, no top-accent
                                stripe. Just the brand name in oversized
                                semibold, one line of subtitle, and a hint
                                to show what the agent needs.
                            -->
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="44" FontWeight="SemiBold" LineHeight="52"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="Vantage" TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="15" LineHeight="24"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Type below to start."
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Modern Composer — fills the window width with a
                         comfortable outer padding so it never feels like
                         a tiny card floating on white space. -->
                    <Border
                        x:Name="ComposerHost"
                        Grid.Row="2"
                        Padding="32,16,32,24">
                        <Border
                            x:Name="ComposerCard"
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource ComposerBrush}"
                            BorderBrush="{StaticResource ComposerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ComposerRadius}">
                            <Grid Padding="14,10,10,10" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--
                                    Model selector — populated from every
                                    provider the user has enabled, displayed
                                    as "Provider Name · model id". User picks
                                    which provider+model pair every message
                                    should route through; selection is
                                    persisted in LocalSettings so it
                                    survives restarts.
                                -->
                                <ComboBox
                                    x:Name="ModelSelector"
                                    Grid.Row="0"
                                    HorizontalAlignment="Stretch"
                                    MinHeight="36"
                                    Padding="10,4,10,4"
                                    DisplayMemberPath="Display"
                                    SelectionChanged="ModelSelector_SelectionChanged" />

                                <Grid Grid.Row="1" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="InputBox"
                                        Grid.Column="0"
                                        MinHeight="28"
                                        MaxHeight="180"
                                        PlaceholderText="Message Vantage&#x2026;"
                                        KeyDown="InputBox_KeyDown"
                                        Style="{StaticResource ComposerTextBoxStyle}" />
                                    <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                        <Button x:Name="SendButton" Width="42" Height="42" Padding="0" Background="{StaticResource AccentBrush}" BorderThickness="0" Click="SendButton_Click" CornerRadius="13" Style="{StaticResource AccentFilledButtonStyle}">
                                            <FontIcon FontSize="15" Foreground="White" Glyph="&#xE724;" />
                                        </Button>
                                        <Button x:Name="StopButton" Width="42" Height="42" Padding="0" Background="{StaticResource WarmBrush}" BorderThickness="0" Click="StopButton_Click" CornerRadius="13" Visibility="Collapsed" Style="{StaticResource WarmFilledButtonStyle}">
                                            <FontIcon FontSize="14" Foreground="White" Glyph="&#xE15B;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- SETTINGS PAGE -->
                <ScrollViewer
                    x:Name="SettingsGrid"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed"
                    Background="{StaticResource PageBrush}">
                    <Grid Padding="44,32,44,48">
                        <Grid HorizontalAlignment="Stretch" MaxWidth="720">
                            <StackPanel Spacing="22">
                                <StackPanel Spacing="8" Margin="0,0,0,12">
                                    <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="Settings" />
                                    <TextBlock FontSize="14" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Customize how Vantage looks, starts, and manages your data." />
                                </StackPanel>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel Spacing="18">
                                        <StackPanel Spacing="6">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Appearance" />
                                            <TextBlock FontSize="13" LineHeight="20" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Pick an accent color, then choose light or dark to match your workspace. The change is instant." />
                                        </StackPanel>

                                        <!--
                                            Palette picker — horizontal strip
                                            of radio cards, a swatch + label
                                            each. Built directly in code-behind
                                            (WinUI 3 doesn't ship WrapPanel
                                            the way WPF does — using a custom
                                            stack here keeps the markup simple
                                            and the cards identical).
                                        -->
                                        <ScrollViewer HorizontalScrollMode="Enabled"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollMode="Disabled"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="PalettePicker"
                                                        Loaded="PalettePicker_Loaded"
                                                        Orientation="Horizontal" Spacing="8" />
                                        </ScrollViewer>

                                        <StackPanel Spacing="8">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Text="Theme mode" />
                                            <ComboBox
                                                x:Name="ThemeModeCombo"
                                                Width="280"
                                                HorizontalAlignment="Left"
                                                SelectionChanged="ThemeModeCombo_SelectionChanged">
                                                <ComboBoxItem Content="Light"   Tag="Light" />
                                                <ComboBoxItem Content="Dark"    Tag="Dark" />
                                                <ComboBoxItem Content="System (follow Windows)" Tag="System" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel Spacing="14">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="Data" />
                                        <TextBlock FontSize="13" LineHeight="20" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Vantage stores chat history locally on this PC. Clear it whenever you want a fresh start." />
                                        <Button HorizontalAlignment="Left" Background="{StaticResource DangerBrush}" BorderThickness="0" Click="ClearHistoryButton_Click" CornerRadius="8" Foreground="White" Padding="14,9">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="14" Foreground="White" Glyph="&#xE74D;" />
                                                <TextBlock Text="Clear all chat history" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="About Vantage" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Text="Vantage v1.0 &#x2014; Local-first AI control panel for Windows." />
                                        <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="Built with Windows App SDK and WinUI 3." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- PROVIDERS PAGE -->
                <ScrollViewer
                    x:Name="ProvidersGrid"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed"
                    Background="{StaticResource PageBrush}">
                    <Grid Padding="44,32,44,48">
                        <Grid HorizontalAlignment="Stretch" MaxWidth="720">
                            <StackPanel Spacing="22">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Top">
                                        <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Text="AI Providers" />
                                        <TextBlock FontSize="14" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Text="Connect Vantage to a language model. Built-in providers can be removed, or add your own custom endpoint." />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Margin="24,6,0,0"
                                        Background="{StaticResource AccentBrush}"
                                        BorderThickness="0"
                                        Click="AddProviderButton_Click"
                                        CornerRadius="10"
                                        MinHeight="44"
                                        Padding="22,0,22,0"
                                        Style="{StaticResource AccentFilledButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontSize="15" Foreground="White" Glyph="&#xE710;" />
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="White" Text="Add provider" TextLineBounds="Tight" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel x:Name="ProvidersList" Spacing="14" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Agent overlay removed — the user wanted zero UI intrusions. The
             agent now runs invisibly; Escape + composer Stop button + the
             20-step cap are the only remaining safety surfaces. -->
    </Grid>
</Window>
