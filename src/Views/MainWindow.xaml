<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Vantage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vantage">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <!--
                Vantage brushes. StaticResource SolidColorBrush — flat
                (no ThemeDictionary wrapper at this scope; that pattern
                needs ResourceDictionary at App.Resources level which is
                coming in a follow-up). All brushes are picked to read
                well against the off-white page AND against dark system
                page backgrounds via subtle alpha overlays.
            -->
            <SolidColorBrush x:Key="PageBrush" Color="#F7FAFB" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFFFFFF" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F2F6F7" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#2607141A" />
            <SolidColorBrush x:Key="SoftStrokeBrush" Color="#1607141A" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#101A24" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6D7D86" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#94A0A6" />
            <!-- Used for inline error / validation messages (Add Provider
                 dialog, etc.). WinUI's ResourceDictionary INDEXER throws
                 when the key is missing, so we DO define this on purpose
                 rather than relying on a defensive fallback. -->
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />

            <!--
                Message bubble brushes — set as SolidColorBrush so they can
                be mutated in place by ThemeManager.Apply when the user
                switches palettes or switches dark mode. ChatMessage.cs
                reads them via BrushResolver.
            -->
            <SolidColorBrush x:Key="BubbleUserBrush" Color="#E8F1FB" />
            <SolidColorBrush x:Key="BubbleAssistantBrush" Color="#00FFFFFF" />
            <SolidColorBrush x:Key="BubbleErrorBrush" Color="#FBEEE8" />
            <SolidColorBrush x:Key="BubbleBorderUserBrush" Color="#260078D4" />
            <SolidColorBrush x:Key="BubbleBorderAssistantBrush" Color="#00000000" />
            <SolidColorBrush x:Key="BubbleBorderErrorBrush" Color="#E9B9A7" />
            <SolidColorBrush x:Key="AvatarUserBrush" Color="#E2E9EE" />
            <SolidColorBrush x:Key="AvatarAssistantBrush" Color="#D6E7F8" />
            <SolidColorBrush x:Key="AvatarErrorBrush" Color="#FBEEE8" />
            <SolidColorBrush x:Key="AuthorTextBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AuthorErrorBrush" Color="#B3261E" />
            <!-- Keep the navigation quiet so conversations remain the focus. -->
            <SolidColorBrush x:Key="PaneBrush" Color="#F2F5F7" />
            <SolidColorBrush x:Key="RailBrush" Color="#E8EEF5" />
            <SolidColorBrush x:Key="ChatCanvasBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="PaneEdgeBrush" Color="#1607141A" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#1A86E0" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#0064B0" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F1FB" />
            <SolidColorBrush x:Key="WarmBrush" Color="#B66A42" />
            <SolidColorBrush x:Key="WarmHoverBrush" Color="#C77C58" />
            <SolidColorBrush x:Key="WarmPressedBrush" Color="#8E5030" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#237A4B" />
            <SolidColorBrush x:Key="SuccessSoftBrush" Color="#D8EFE2" />
            <SolidColorBrush x:Key="DangerBrush" Color="#A83232" />
            <SolidColorBrush x:Key="PanelTintBrush" Color="#E5F0FA" />
            <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComposerBorderBrush" Color="#D8DEE3" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="PendingBackgroundBrush" Color="#F7FAFB" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
            <!-- Gradients are not animated: ThemeManager rewrites their stops. -->
            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1A86E0" />
                <GradientStop Offset="1" Color="#0078D4" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="HeroGlowBrush">
                <GradientStop Offset="0" Color="#300078D4" />
                <GradientStop Offset="1" Color="#000078D4" />
            </RadialGradientBrush>

            <!-- Stock buttons, primary dialog buttons and check boxes follow the palette. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFF2F6F7" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFE8EEF0" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE0E8EA" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#101A24" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#101A24" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#101A24" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1607141A" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2607141A" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2607141A" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0078D4" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#1A86E0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0064B0" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#0078D4" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#1A86E0" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0064B0" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#0078D4" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#1A86E0" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#0064B0" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFFFF" />

            <!--
                Lightweight-styling overrides for every TextBox / PasswordBox
                inside the window. WinUI's template switches to its own system
                greys on hover/focus (TextControlBackground*), which painted a
                mismatched slab inside the dark composer. ThemeManager keeps
                these in step with the palette.
            -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D8DEE3" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#D8DEE3" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0078D4" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#D8DEE3" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#101A24" />
            <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#101A24" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#101A24" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#94A0A6" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#94A0A6" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#94A0A6" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#94A0A6" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#94A0A6" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#0078D4" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0078D4" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1A86E0" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0064B0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#0078D4" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#1A86E0" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#0064B0" />
            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D8DEE3" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#D8DEE3" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#D8DEE3" />
            <SolidColorBrush x:Key="TextControlButtonForeground" Color="#66708A" />
            <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#101A24" />

            <!-- Borderless variant for boxes that sit inside their own card
                 (composer, search): every state stays transparent so the card
                 colour shows through and no inner rectangle appears. -->
            <Style x:Key="BorderlessTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
            </Style>

            <CornerRadius x:Key="ComposerRadius">18</CornerRadius>
            <ThemeShadow x:Key="ComposerShadow" />

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="SuggestionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SuggestionRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SuggestionRoot" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ComposerTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BorderlessTextBoxStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <!-- AcceptsReturn=False so Enter doesn't insert a newline on
                     its own; our KeyDown handler always sends with Enter
                     and inserts a newline on Shift/Ctrl+Alt+Enter. -->
                <Setter Property="AcceptsReturn" Value="False" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
            </Style>

            <Style x:Key="GroupLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,18,0,4" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>
            <Style x:Key="RowTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="RowDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            </Style>

            <!-- Messages manage their own width and hover; the container adds nothing. -->
            <Style x:Key="MessageListItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SoftAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PanelTintBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One option of a segmented control. -->
            <Style x:Key="SegmentStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="SegmentRoot" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter x:Name="SegmentContent" Margin="12,6" VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SurfaceElevatedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SegmentRoot" Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SoftStrokeBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SegmentContent" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="Text" Value=" " />
            </Style>

            <!-- Settings cards use layered Fluent surfaces and a restrained stroke. -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!--
                MessageBubble — chat message surface. Same shadow recipe
                but tighter radius (12) and slightly smaller padding so
                consecutive messages stack visually without feeling
                monolithic.
            -->
            <Style x:Key="MessageBubble" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,11" />
            </Style>

            <Style x:Key="ConversationListItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="ItemRoot" Background="Transparent" CornerRadius="9">
                                <Rectangle x:Name="SelectionIndicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left" Margin="2,0,0,0" Fill="{StaticResource AccentBrush}" Opacity="0" />
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SubtleSurfaceBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected" />
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PanelTintBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedUnfocused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PanelTintBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimation Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                WinUI 3's default Button template swaps Background to a
                near-white theme brush on hover, which would hide our
                solid-fill buttons. Defining a custom ControlTemplate
                with VisualStateManager + Storyboard animations on the
                RootGrid's Background gives us full control over the
                visual states.
            -->
            <Style x:Key="GhostIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SubtleSurfaceBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ComposerModeToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="78" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ModeContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource HoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SubtleSurfaceBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentSoftBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ModeContent" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentFilledButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <!--
                    Default Padding = 14,8 keeps a balanced rhythm for
                    small icon-only buttons (40px circular). Buttons
                    that pass in their own Padding (e.g. the Add provider
                    CTA) override this and get shaped correctly because
                    the ContentPresenter's Margin is bound to Padding
                    below — fixing the old bug where the Style hardcoded
                    Padding=0 and silently overrode every instance.
                -->
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WarmFilledButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource WarmBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WarmHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="(Panel.Background)">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource WarmPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="RootGrid"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.5" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Window base: the palette tint over Mica. The sidebar and title bar
             sit directly on it; the content floats above it as one surface. -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{StaticResource PaneBrush}" />

        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TitlebarNavBackdrop" Width="264" Background="Transparent" />
            <StackPanel x:Name="BrandText" Orientation="Horizontal" Spacing="9" Margin="18,0,48,0" VerticalAlignment="Center">
                <Image Width="20" Height="20" Source="ms-appx:///Assets/Square44x44Logo.targetsize-44_altform-unplated.png" />
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" Text="Vantage" />
            </StackPanel>
            <Button x:Name="PaneToggleButton" Width="32" Height="32" Margin="220,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0"
                    Background="Transparent" BorderThickness="0" Click="PaneToggleButton_Click" Loaded="PaneToggleButton_LayoutChanged" SizeChanged="PaneToggleButton_LayoutChanged"
                    CornerRadius="8" Style="{StaticResource GhostIconButtonStyle}"
                    AutomationProperties.Name="Toggle sidebar"
                    ToolTipService.ToolTip="Collapse sidebar">
                <FontIcon x:Name="PaneToggleGlyph" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE76B;" />
            </Button>

            <!-- Conversation context, shown only on the chat page. -->
            <StackPanel x:Name="ChatHeader" Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ConversationTitleBlock" MaxWidth="520" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" Text="New chat" TextTrimming="CharacterEllipsis" />
                <Border x:Name="RunStatusPill" Padding="9,3" CornerRadius="999" Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="RunStatusPulse" Width="6" Height="6" VerticalAlignment="Center" Fill="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="RunStatusText" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="Running" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock x:Name="ConversationSubtitleBlock" Visibility="Collapsed" Text="" />
        </Grid>

        <!-- ============ SIDEBAR ============ -->
        <Grid x:Name="SidebarHost" Grid.Row="1" Background="Transparent">
            <Grid x:Name="ConversationPane" Width="264" HorizontalAlignment="Left" Padding="12,2,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NewChatButton" Height="38" Padding="12,0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Click="NewChatButton_Click"
                            Style="{StaticResource SoftAccentButtonStyle}" AutomationProperties.Name="New chat">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon FontSize="14" Foreground="{StaticResource AccentBrush}" Glyph="&#xE710;" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="New chat" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Width="38" Height="38" Padding="0" Click="HeaderSearchButton_Click"
                            Background="Transparent" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}"
                            AutomationProperties.Name="Search messages" ToolTipService.ToolTip="Search messages">
                        <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE721;" />
                    </Button>
                </Grid>

                <StackPanel x:Name="SearchPanel" Grid.Row="1" Spacing="8" Margin="0,10,0,0" Visibility="Collapsed">
                    <Border Height="36" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource SoftStrokeBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <TextBox x:Name="SearchBox" Style="{StaticResource BorderlessTextBoxStyle}" Padding="10,5" FontSize="13"
                                 MinHeight="0" PlaceholderText="Search every message" TextChanged="SearchBox_TextChanged">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                    </Border>
                    <Border x:Name="SearchResultsHost" MaxHeight="220" Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource SoftStrokeBrush}" BorderThickness="1" CornerRadius="10"
                            Visibility="Collapsed">
                        <ListView x:Name="SearchResultsList" IsItemClickEnabled="True"
                                  ItemClick="SearchResultsList_ItemClick" SelectionMode="None">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="12" />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="58" Padding="10,7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" MaxLines="2" FontSize="12.5" Foreground="{StaticResource PrimaryTextBrush}"
                                                   Text="{Binding Snippet}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Margin="12,16,0,6" FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                           Foreground="{StaticResource MutedTextBrush}" Text="Recent" />

                <Grid Grid.Row="3">
                    <ListView x:Name="ConversationList" IsItemClickEnabled="True"
                              ItemClick="ConversationList_ItemClick" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource ConversationListItemStyle}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <ReorderThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="38" Padding="12,0,10,0" ColumnSpacing="10" Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Tag="{Binding}" Text="Rename" Click="RenameConversationMenuItem_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Tag="{Binding}" Text="Delete" Click="DeleteConversationMenuItem_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"
                                               Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding UpdatedLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="SidebarEmptyState" Margin="12,6,0,0" HorizontalAlignment="Left"
                               VerticalAlignment="Top" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               Text="No conversations yet" Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Row="4" Spacing="2" Margin="0,8,0,0">
                    <Button x:Name="ProvidersButton" Height="36" Padding="12,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Click="ProvidersButton_Click"
                            CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}" AutomationProperties.Name="AI providers">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE950;" />
                            <TextBlock FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Text="AI providers" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Height="36" Padding="12,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Click="SettingsButton_Click"
                            CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE713;" />
                            <TextBlock FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="CollapsedSidebarCommands" Width="64" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,2,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <Button Width="38" Height="38" Padding="0" Click="NewChatButton_Click"
                            Style="{StaticResource SoftAccentButtonStyle}" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="New chat" ToolTipService.ToolTip="New chat">
                        <FontIcon FontSize="14" Foreground="{StaticResource AccentBrush}" Glyph="&#xE710;" />
                    </Button>
                    <Button Width="38" Height="38" Padding="0" Background="Transparent" BorderThickness="0"
                            Click="HeaderSearchButton_Click" CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}"
                            AutomationProperties.Name="Search messages" ToolTipService.ToolTip="Search messages">
                        <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE721;" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="2" HorizontalAlignment="Center">
                    <Button x:Name="ProvidersButtonCollapsed" Width="38" Height="38" Padding="0"
                            Background="Transparent" BorderThickness="0" Click="ProvidersButton_Click"
                            CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}"
                            AutomationProperties.Name="AI providers" ToolTipService.ToolTip="AI providers">
                        <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE950;" />
                    </Button>
                    <Button x:Name="SettingsButtonCollapsed" Width="38" Height="38" Padding="0"
                            Background="Transparent" BorderThickness="0" Click="SettingsButton_Click"
                            CornerRadius="10" Style="{StaticResource GhostIconButtonStyle}"
                            AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE713;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ CONTENT SURFACE ============ -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" CornerRadius="14"
                Background="{StaticResource ChatCanvasBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <Grid>
                <!-- CHAT WORKSPACE -->
                <Grid x:Name="Workspace" Background="Transparent" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="MessagesList" Padding="24,20,24,8" SelectionMode="None" Background="Transparent"
                              ItemContainerStyle="{StaticResource MessageListItemStyle}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="14" />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MaxWidth="760" Padding="0,8,0,2" Background="Transparent"
                                      PointerEntered="MessageRow_PointerEntered" PointerExited="MessageRow_PointerExited">
                                    <Grid HorizontalAlignment="{Binding BubbleAlignment}" ColumnSpacing="{Binding MessageColumnSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding AvatarColumnWidth}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="9" Background="{Binding AvatarBrush}"
                                                VerticalAlignment="Top" Visibility="{Binding AvatarVisibility}">
                                            <Image Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Source="ms-appx:///Assets/Square44x44Logo.targetsize-44_altform-unplated.png" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <!-- Text message: the assistant writes on the canvas,
                                                 the user and errors get a tinted bubble. -->
                                            <Border CornerRadius="{Binding BubbleCornerRadius}" Padding="{Binding BubblePadding}"
                                                    MaxWidth="{Binding BubbleMaxWidth}"
                                                    HorizontalAlignment="{Binding BubbleAlignment}"
                                                    Background="{Binding BubbleBrush}" BorderBrush="{Binding BubbleBorderBrush}"
                                                    BorderThickness="1" Visibility="{Binding ContentVisibility}">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding MetadataVisibility}">
                                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding AuthorBrush}"
                                                                   Text="{Binding AuthorDisplay}" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding TimeLabel}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Border MaxHeight="320" Margin="0,2,0,2" Background="{StaticResource SubtleSurfaceBrush}"
                                                            CornerRadius="10" Visibility="{Binding ImageVisibility}">
                                                        <Image MaxHeight="300" Source="{Binding ImageSource}" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock FontSize="14" LineHeight="23" Foreground="{StaticResource PrimaryTextBrush}"
                                                               IsTextSelectionEnabled="True"
                                                               Text="{Binding CleanText}" TextWrapping="Wrap" Visibility="{Binding TextVisibility}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Agent run: header, slim progress, stepper, counters, outcome. -->
                                            <Border CornerRadius="14" Margin="0,2,0,0" Background="{StaticResource SurfaceElevatedBrush}"
                                                    BorderBrush="{StaticResource SoftStrokeBrush}" BorderThickness="1"
                                                    Visibility="{Binding AgentRunVisibility}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Padding="16,12,14,10" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                                                       Text="{Binding AgentRun.HeaderTitle}" />
                                                            <TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                                                       Text="{Binding AgentRun.StatusText}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Padding="9,3" CornerRadius="999"
                                                                Background="{StaticResource SubtleSurfaceBrush}" VerticalAlignment="Center">
                                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"
                                                                       Text="{Binding AgentRun.ElapsedLabel}" />
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Row="1" Padding="16,0,16,14" Spacing="12">
                                                        <ProgressBar Height="3" MinHeight="3" CornerRadius="2" Minimum="0" Maximum="100"
                                                                     IsIndeterminate="{Binding AgentRun.ProgressIndeterminate}"
                                                                     Value="{Binding AgentRun.ProgressPercent}"
                                                                     Foreground="{StaticResource AccentBrush}"
                                                                     Background="{StaticResource SubtleSurfaceBrush}" />
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE8D7;" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"
                                                                      Foreground="{StaticResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                                                       TextWrapping="WrapWholeWords" Text="{Binding AgentRun.EvidenceSummary}" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding AgentRun.Phases}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid ColumnSpacing="10">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="20" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="20" />
                                                                                <RowDefinition Height="*" />
                                                                            </Grid.RowDefinitions>
                                                                            <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                                                                <FontIcon Glyph="{Binding IconGlyph}" FontSize="10" Foreground="{StaticResource AccentBrush}"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <Rectangle Grid.Row="1" Width="1" MinHeight="6" HorizontalAlignment="Center" Fill="{StaticResource StrokeBrush}" />
                                                                        </Grid>
                                                                        <StackPanel Grid.Column="1" Margin="0,0,0,8">
                                                                            <TextBlock FontSize="13" Margin="0,1,0,0" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Title}" />
                                                                            <TextBlock FontSize="12" Margin="0,1,0,0" Foreground="{StaticResource MutedTextBrush}"
                                                                                       Text="{Binding Subtitle}" TextWrapping="Wrap" Visibility="{Binding HasSubtitle}" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" FontSize="11.5" Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}"
                                                                                   Text="{Binding DurationLabel}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding AgentRun.Counters}" Visibility="{Binding AgentRun.CountersVisibility}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="9,3" Margin="0,0,6,0" CornerRadius="999" Background="{StaticResource SubtleSurfaceBrush}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <FontIcon Glyph="{Binding Glyph}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                                                            <TextBlock FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Label}" />
                                                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Count}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <Border Padding="12,8" CornerRadius="10" Visibility="{Binding AgentRun.IsFinishedVisibility}"
                                                                Background="{StaticResource SubtleSurfaceBrush}">
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                                                       Text="{Binding AgentRun.TerminationLabel}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Revealed on hover or keyboard focus. Space stays reserved
                                                 so messages never shift while the pointer moves. -->
                                            <Button x:Name="CopyAction" HorizontalAlignment="{Binding BubbleAlignment}"
                                                    Margin="0,2,0,0" Padding="0" Width="26" Height="26" Opacity="0" CornerRadius="8"
                                                    Click="CopyMessageButton_Click" Tag="{Binding}"
                                                    GotFocus="CopyAction_GotFocus" LostFocus="CopyAction_LostFocus"
                                                    AutomationProperties.Name="Copy message" ToolTipService.ToolTip="Copy message"
                                                    Style="{StaticResource GhostIconButtonStyle}"
                                                    Visibility="{Binding CopyButtonVisibility}">
                                                <Button.OpacityTransition>
                                                    <ScalarTransition Duration="0:0:0.12" />
                                                </Button.OpacityTransition>
                                                <FontIcon FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Glyph="&#xE8C8;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state: a soft accent glow behind the mark, then starters. -->
                    <Grid x:Name="EmptyState" Margin="24,0,24,12" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                        <Grid.ChildrenTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="16" />
                            </TransitionCollection>
                        </Grid.ChildrenTransitions>
                        <Ellipse Width="400" Height="400" VerticalAlignment="Top" Margin="0,-170,0,0" IsHitTestVisible="False"
                                 Fill="{StaticResource HeroGlowBrush}" />
                        <StackPanel Spacing="8">
                            <Image Width="56" Height="56" Margin="0,0,0,10" HorizontalAlignment="Center"
                                   Source="ms-appx:///Assets/Square150x150Logo.scale-200.png" />
                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="What can I help with?" TextAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Ask a question, or tell Vantage what to do on your PC." TextAlignment="Center" TextWrapping="Wrap" />
                            <Grid Margin="0,20,0,0" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Style="{StaticResource SuggestionButtonStyle}" Click="SuggestionButton_Click"
                                        Tag="Open Settings and check for Windows updates.">
                                    <Grid ColumnSpacing="11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontSize="15" Foreground="{StaticResource AccentBrush}" Glyph="&#xE895;" /><TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Text="Check for Windows updates" /></Grid>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource SuggestionButtonStyle}" Click="SuggestionButton_Click"
                                        Tag="Find the largest files in my Downloads folder.">
                                    <Grid ColumnSpacing="11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontSize="15" Foreground="{StaticResource AccentBrush}" Glyph="&#xE8B7;" /><TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Text="Find my largest downloads" /></Grid>
                                </Button>
                                <Button Grid.Row="1" Style="{StaticResource SuggestionButtonStyle}" Click="SuggestionButton_Click"
                                        Tag="Open Microsoft Edge and search for today's top news.">
                                    <Grid ColumnSpacing="11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontSize="15" Foreground="{StaticResource AccentBrush}" Glyph="&#xE774;" /><TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Text="Look up today's news" /></Grid>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SuggestionButtonStyle}" Click="SuggestionButton_Click"
                                        Tag="Explain this in simple terms: ">
                                    <Grid ColumnSpacing="11"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontSize="15" Foreground="{StaticResource AccentBrush}" Glyph="&#xE82F;" /><TextBlock Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" Text="Explain something simply" /></Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Composer: the message grows upward, tools sit below it. -->
                    <Border x:Name="ComposerHost" Grid.Row="1" Padding="24,0,24,18" MaxWidth="808" HorizontalAlignment="Stretch">
                        <Border x:Name="ComposerCard" Background="{StaticResource ComposerBrush}"
                                BorderBrush="{StaticResource ComposerBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource ComposerRadius}"
                                Shadow="{StaticResource ComposerShadow}" Translation="0,0,16">
                            <Grid Padding="16,10,10,10" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="InputBox" MinHeight="28" MaxHeight="168"
                                         PlaceholderText="Message Vantage" KeyDown="InputBox_KeyDown"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource ComposerTextBoxStyle}">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                    </TextBox.Resources>
                                </TextBox>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModelSelector" MinWidth="120" MaxWidth="340" Height="34" Margin="-8,0,0,0"
                                              Padding="8,0,0,0" CornerRadius="10" BorderThickness="0" HorizontalAlignment="Left"
                                              VerticalAlignment="Center" Background="Transparent"
                                              SelectionChanged="ModelSelector_SelectionChanged"
                                              AutomationProperties.Name="Active model" ToolTipService.ToolTip="Active model">
                                        <ComboBox.Resources>
                                            <SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="Transparent" />
                                            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="HoverBrush" />
                                            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="HoverBrush" />
                                        </ComboBox.Resources>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="7" ToolTipService.ToolTip="{Binding Tooltip}">
                                                    <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Display}" />
                                                    <TextBlock FontSize="11.5" VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}" Text="{Binding ProviderDisplay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="SendButton" Width="34" Height="34" Padding="0" Background="{StaticResource AccentGradientBrush}"
                                                Click="SendButton_Click" CornerRadius="17" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Style="{StaticResource AccentFilledButtonStyle}"
                                                AutomationProperties.Name="Send message" ToolTipService.ToolTip="Send message">
                                            <FontIcon FontSize="13" Foreground="{StaticResource OnAccentBrush}" Glyph="&#xE724;" />
                                        </Button>
                                        <Button x:Name="StopButton" Width="34" Height="34" Padding="0" Background="{StaticResource WarmBrush}"
                                                Click="StopButton_Click" CornerRadius="17" Visibility="Collapsed"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Style="{StaticResource WarmFilledButtonStyle}"
                                                AutomationProperties.Name="Stop response" ToolTipService.ToolTip="Stop response">
                                            <FontIcon FontSize="12" Foreground="White" Glyph="&#xE15B;" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- SETTINGS PAGE -->
                <Border x:Name="SettingsGrid" CornerRadius="13" Background="{StaticResource PageBrush}" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" Padding="28,30,28,36" Spacing="6">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />

                            <TextBlock Style="{StaticResource GroupLabelStyle}" Text="Appearance" />
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <StackPanel Padding="18,16,18,10" Spacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="Accent colour" />
                                            <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Tints the whole app, not just the buttons." />
                                        </StackPanel>
                                        <VariableSizedWrapGrid x:Name="PalettePicker" Loaded="PalettePicker_Loaded"
                                                               Orientation="Horizontal" ItemWidth="82" ItemHeight="84" />
                                    </StackPanel>
                                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                    <Grid Padding="18,14" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowTitleStyle}" Text="Theme" />
                                            <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Light, dark, or follow Windows." />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="3" CornerRadius="11" Background="{StaticResource SubtleSurfaceBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <RadioButton x:Name="ThemeLightOption" GroupName="ThemeMode" Tag="Light" Checked="ThemeMode_Checked" Style="{StaticResource SegmentStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="13" Glyph="&#xE706;" />
                                                        <TextBlock FontSize="12.5" Text="Light" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="ThemeDarkOption" GroupName="ThemeMode" Tag="Dark" Checked="ThemeMode_Checked" Style="{StaticResource SegmentStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="13" Glyph="&#xE708;" />
                                                        <TextBlock FontSize="12.5" Text="Dark" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="ThemeSystemOption" GroupName="ThemeMode" Tag="System" Checked="ThemeMode_Checked" Style="{StaticResource SegmentStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <FontIcon FontSize="13" Glyph="&#xE7F4;" />
                                                        <TextBlock FontSize="12.5" Text="System" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource GroupLabelStyle}" Text="Data" />
                            <Border Style="{StaticResource SectionCard}">
                                <Grid Padding="18,14" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitleStyle}" Text="Chat history" />
                                        <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Stays on this PC until you clear it." />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Background="Transparent" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                                            Click="ClearHistoryButton_Click" CornerRadius="9" Foreground="{StaticResource DangerBrush}" Padding="12,6">
                                        <TextBlock FontSize="12.5" Foreground="{StaticResource DangerBrush}" Text="Clear history" />
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource GroupLabelStyle}" Text="About" />
                            <Border Style="{StaticResource SectionCard}">
                                <Grid Padding="18,14" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Width="32" Height="32" VerticalAlignment="Center" Source="ms-appx:///Assets/Square44x44Logo.targetsize-44_altform-unplated.png" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutVersionText" Style="{StaticResource RowTitleStyle}" TextWrapping="Wrap" Text="Vantage" />
                                        <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="Windows App SDK 1.8 &#x2022; WinUI 3" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- PROVIDERS PAGE -->
                <Border x:Name="ProvidersGrid" CornerRadius="13" Background="{StaticResource PageBrush}" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" Padding="28,30,28,36" Spacing="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="AI providers" />
                                    <TextBlock Style="{StaticResource RowDescriptionStyle}" Text="The models and endpoints Vantage can use." />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Background="{StaticResource AccentGradientBrush}"
                                        Click="AddProviderButton_Click" CornerRadius="10" MinHeight="36" Padding="14,0"
                                        VerticalContentAlignment="Center"
                                        Style="{StaticResource AccentFilledButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontSize="12" Foreground="{StaticResource OnAccentBrush}" Glyph="&#xE710;" />
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource OnAccentBrush}" Text="Add provider" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="ProvidersList" Spacing="10" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
