<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Vantage</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>true</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.5.88</Version>
    <AssemblyVersion>1.5.88.0</AssemblyVersion>
    <FileVersion>1.5.88.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Update="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    Exclude the probe-worldstate subproject from this project's default
    Compile globs. The probe shares source files via <Compile Include>
    links, and without this exclude the SDK's recursive "**\*.cs" pick-up
    also pulls in probe-worldstate\Program.cs — and worse, the SDK
    generates a second auto-AssemblyInfo for that subdir, so the
    C# compiler ends up seeing two TargetFrameworkAttribute +
    AssemblyProductAttribute declarations and the build fails with
    "Duplicate attribute" errors. Keeping the probe in a subdir is fine
    as long as the main project explicitly ignores it.
  -->
  <ItemGroup>
    <Compile Remove="probe-worldstate\**" />
    <None    Remove="probe-worldstate\**" />
    <Page    Remove="probe-worldstate\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.UIAutomationClient.Interop">
      <HintPath>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\UIAVerify\Microsoft.UIAutomationClient.Interop.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <Target Name="CopyWinUICompiledResourcesToPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <WinUICompiledResource Include="$(OutDir)*.xbf" />
      <WinUICompiledResource Include="$(OutDir)*.pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUICompiledResource)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
